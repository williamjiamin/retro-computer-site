<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="description" content="$meta_description">
  <meta property="og:type" content="website">
  <meta property="og:title" content="$meta_title">
  <meta property="og:description" content="$meta_description">
  <title>$meta_title — Private Showcase</title>
  <link rel="icon" href="./showcase_assets/mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="./showcase.css">
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<div class="shell">
  <header class="topbar">
    <a class="brand" href="./" aria-label="Retro Computer home">RETRO<span>COMPUTER</span></a>
    <nav class="navlinks" aria-label="Primary">
      <a href="./">Home</a><a href="#rooms">Explore rooms</a><a href="#downloads">Downloads</a><a href="./privacy-policy.html">Privacy</a>
    </nav>
    <span class="status">PRIVATE DRAFT</span>
  </header>
  <main id="content">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">A museum you can step inside</p>
        <h1 id="hero-title">$tagline</h1>
        <p class="intro">$summary</p>
        <a class="cta" href="#rooms">Take the tour</a>
      </div>
      <figure class="art">
        <img src="./downloads/five-room-map.svg" width="1200" height="620" alt="Illustrated timeline of five symbolic computer rooms, from the sixties to today.">
        <figcaption>Original conceptual artwork; not an in-app screenshot.</figcaption>
      </figure>
    </section>
    <div class="metrics" aria-label="Museum at a glance">
      <div class="metric"><strong>$room_count</strong><span>period rooms</span></div>
      <div class="metric"><strong>$desktop_count</strong><span>working desktops</span></div>
      <div class="metric"><strong>$game_count</strong><span>original games</span></div>
    </div>
    <section id="rooms" aria-labelledby="rooms-heading">
      <div class="section-head"><h2 id="rooms-heading">Follow the eras, one room at a time.</h2>
        <p>The rooms form a simple path through the changing shape of everyday computing.</p>
      </div>
      <ol class="rooms">$room_cards</ol>
    </section>
    <section class="stages" aria-labelledby="stages-heading">
      <div class="stages-inner">
        <div><h2 id="stages-heading">More than a display case.</h2>
          <p>Explore working desktops and familiar creative tools. The built-in assistant can run locally on your device.</p></div>
        <ul>
          <li>Explore different desktop eras within the museum.</li>
          <li>Open original games, notes, painting tools, and a terminal.</li>
          <li>Use the on-device assistant without a required account.</li>
        </ul>
      </div>
    </section>
    <section id="downloads" class="downloads" aria-labelledby="downloads-heading">
      <div class="section-head"><h2 id="downloads-heading">Original assets, with checksums.</h2>
        <p>These files are showcase artwork and a fact sheet only. No application installer is distributed here.</p>
      </div>
      <div class="download-grid">$download_cards</div>
      <p class="checksum-note">Each file has a SHA-256 digest. A machine-readable <a href="./downloads/catalog.json">download catalog</a> and <a href="./downloads/SHA256SUMS.txt">checksum list</a> are available for offline verification.</p>
    </section>
  </main>
  <footer class="foot"><span>Original artwork · locally available static page · private draft</span><span><a href="./privacy-policy.html">Privacy policy</a> · <a href="./">Return home</a></span></footer>
</div>
</body>
</html>
