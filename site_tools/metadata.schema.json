{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/retro-showcase/metadata.schema.json",
  "title": "Offline showcase metadata, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "rooms", "downloads"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "summary", "room_count", "desktop_count", "game_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 90},
        "tagline": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "minLength": 1, "maxLength": 400},
        "room_count": {"type": "integer", "minimum": 1, "maximum": 50},
        "desktop_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "game_count": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "rooms": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "era", "name", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
          "era": {"type": "string", "minLength": 1, "maxLength": 24},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "summary": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "downloads": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "label", "summary", "media_type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
          "path": {"type": "string", "pattern": "^downloads/[a-z0-9][a-z0-9._-]{0,100}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "summary": {"type": "string", "minLength": 1, "maxLength": 240},
          "media_type": {"enum": ["image/svg+xml", "text/plain"]}
        }
      }
    }
  }
}
